# The crawler (deploy/box.sh start). Arguments in crawl.args. Exit 3 is Riot rejecting
# the key: logged and not restarted, so a dead key never hammers Riot
[Unit]
Description=meiolol crawler

[Service]
# The data disk (C01: deploy/c01) can come up long after boot: fail here, saying why,
# and Restart tries again, rather than start without it
WorkingDirectory=-%h/ml/meiolol
ExecStartPre=/bin/sh -c 'test -d %h/ml/meiolol/data || { echo "waiting for the data disk: %h/ml/meiolol/data missing" >&2; exit 1; }'
EnvironmentFile=-%h/ml/meiolol/host.env
ExecStart=/bin/sh -c 'bin/meiolol crawl $(cat crawl.args 2>/dev/null) >> data/crawl.log 2>&1; rc=$?; [ $rc -eq 3 ] && echo KEY REJECTED >> data/crawl.log; exit $rc'
Restart=always
RestartSec=60
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
