[Unit]
Description=meiolol backups mirrored onto Megatron, outside the disk image (deploy/backup-mirror.sh, C01)
# Its own mount of the share with nobrl: SQLite's locks fail on CIFS byte-range locks
ConditionPathIsMountPoint=/srv/megatron-backups

[Service]
Type=oneshot
Nice=10
ExecStart=/bin/sh -c 'exec %h/ml/meiolol/bin/backup-mirror.sh megatron /srv/megatron-backups/meiolol/backups %h/ml/meiolol/bin/meiolol local %h/ml/meiolol/bin/backup-serve.sh >> %h/ml/meiolol/data/backup-mirror.log 2>&1'
