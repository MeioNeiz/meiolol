[Unit]
Description=meiolol pages rendered on request for the web server's nginx (meiolol render)

[Service]
WorkingDirectory=%h/ml/meiolol
EnvironmentFile=-%h/ml/meiolol/host.env
# On the private address only: the cloud firewall and iptables let just the web server in
# (docs/hosting.md "Rendering on request"). deploy/web-loop.sh touches data/render.reload
# after each upload
ExecStart=/bin/sh -c 'exec bin/meiolol render --contact "$(cat contact)" --host "$(hostname -I | cut -d" " -f1)" --port 8091 --reload data/render.reload >> data/render.log 2>&1'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
