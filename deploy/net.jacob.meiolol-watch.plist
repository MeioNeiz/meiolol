<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: deploy/box.sh watch install (copies to ~/Library/LaunchAgents, loads it) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.jacob.meiolol-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec "$HOME/personal/meiolol/deploy/mac-watch.sh"</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/meiolol-watch.err</string>
</dict>
</plist>
