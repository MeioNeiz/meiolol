+/// Error of `est` smoothed with `lambda` against the other half's means, per sigma^2
+/// (so late minutes do not outweigh early ones), less the other half's noise, summed
+/// over minutes and pairs
+fn halfScore(
+    groups: []const Group,
+    est: []const Est,
+    other: []const Cells,
+    params: *const [metrics][max_minutes]Param,
+    mi: usize,
+    lambda: f64,
+) f64 {
+    var score: f64 = 0;
+    for (groups, est, other) |g, e, o| {
+        if (g.mirror()) continue;
+        var one = e;
+        var only: [metrics]f64 = @splat(0);
+        only[mi] = lambda;
+        smooth(&one, only);
+        for (0..max_minutes) |t| {
+            const s = o[mi][t];
+            const sigma2: f64 = params[mi][t].sigma2;
+            if (s.n == 0 or one[mi][t].n == 0 or sigma2 == 0) continue;
+            const d = one[mi][t].mean - s.mean();
+            score += (d * d - sigma2 / s.n) / sigma2;
+        }
+    }
+    return score;
+}
