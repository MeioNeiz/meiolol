+/// One metric and minute of the top level: champion effects into `effects`, sigma^2 and
+/// tau^2 into `p`; returns the pairs tau^2 was estimated from
+fn topParams(
+    groups: []const Group,
+    cells: []const Cells,
+    mi: usize,
+    t: usize,
+    matrix: []f64,
+    effects: []f64,
+    games: []f64,
+    p: *Param,
+) f64 {
+    const sigma2 = pooled(cells, mi, t);
+    // A first fit with a token ridge only fixes the level (effects sum to ~0)
+    championEffects(groups, cells, mi, t, 1, matrix, effects, games) catch unreachable;
+    var tau_e: f64 = 0;
+    var counted: f64 = 0;
+    for (effects, games) |e, n| if (n > 0) {
+        tau_e += e * e - sigma2 / n;
+        counted += 1;
     };
+    tau_e = @max(tau_floor * sigma2, if (counted > 0) tau_e / counted else 0);
+    if (sigma2 > 0) championEffects(groups, cells, mi, t, @max(sigma2 / tau_e, 1), matrix, effects, games) catch unreachable;
+
+    var tau2: f64 = 0;
+    var pairs: f64 = 0;
+    for (groups, cells) |g, c| {
+        const s = c[mi][t];
+        if (g.mirror() or s.n < 2) continue;
+        const r = s.mean() - (effects[g.a] - effects[g.b]);
+        tau2 += r * r - s.variance() / s.n;
+        pairs += 1;
+    }
+    tau2 = @max(tau_floor * sigma2, if (pairs > 0) tau2 / pairs else 0);
+    p.* = .{ .sigma2 = @floatCast(sigma2), .tau2 = @floatCast(tau2) };
+    return pairs;
+}
+
+/// Whittaker on log tau^2 over the leading minutes that have pairs, weighted by pairs,
+/// floored as before. The smoothed values are the parameters: k follows them
+fn smoothTau(ps: *[max_minutes]Param, pairs: [max_minutes]f64, lambda: f64) void {
+    if (lambda == 0) return;
+    var last: usize = 0;
+    while (last < max_minutes and pairs[last] > 0 and ps[last].tau2 > 0) last += 1;
+    if (last < 3) return;
+    var y: [max_minutes]f64 = undefined;
+    var z: [max_minutes]f64 = undefined;
+    for (0..last) |t| y[t] = @log(@as(f64, ps[t].tau2));
+    whittaker(y[0..last], pairs[0..last], lambda, z[0..last]);
+    for (ps[0..last], z[0..last]) |*p, v| p.tau2 = @floatCast(@max(tau_floor * p.sigma2, @exp(v)));
+}
+
+/// rms second difference of log k over the leading minutes with a k
+fn jitter(ps: *const [max_minutes]Param) f64 {
+    var last: usize = 0;
+    while (last < max_minutes and ps[last].k() > 0) last += 1;
+    if (last < 3) return 0;
+    var ss: f64 = 0;
+    for (1..last - 1) |t| {
+        const d = @log(ps[t - 1].k()) - 2 * @log(ps[t].k()) + @log(ps[t + 1].k());
+        ss += d * d;
+    }
+    return @sqrt(ss / @as(f64, @floatFromInt(last - 2)));
+}
