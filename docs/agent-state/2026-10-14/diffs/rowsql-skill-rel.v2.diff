+test "relative rates and skill count only games ended by the start, brute force" {
+    const gpa = std.testing.allocator;
+    var prng: std.Random.DefaultPrng = .init(11);
+    const rnd = prng.random();
+    const n_games = 400;
+    const games = try gpa.alloc(Game, n_games);
+    defer gpa.free(games);
+    var rws: std.ArrayList(Row) = .empty;
+    defer rws.deinit(gpa);
+    var players: std.ArrayList(u32) = .empty;
+    defer players.deinit(gpa);
+    var extras: std.ArrayList(Extra) = .empty;
+    defer extras.deinit(gpa);
+    for (games, 0..) |*g, gi| {
+        // Starts 10 minutes (+ gi ms) apart, up to 40 minutes long: many overlap, and no
+        // two games end on the same ms, so the running means' order is fixed
+        g.* = .{
+            .match_id = "",
+            .start = @intCast(gi * 600_001),
+            .patch = 0,
+            .platform = 0,
+            .is_test = false,
+            .teams = undefined,
+            .winner = rnd.int(u1),
+            .duration_s = rnd.intRangeLessThan(u32, 600, 2400),
+        };
+        // Within a game, players and champions are distinct, as in real games
+        var pool: [30]u32 = undefined;
+        for (&pool, 0..) |*x, k| x.* = @intCast(k);
+        rnd.shuffle(u32, &pool);
+        var champs: [12]u32 = undefined;
+        for (&champs, 0..) |*x, k| x.* = @intCast(k + 1);
+        rnd.shuffle(u32, &champs);
+        for (0..10) |slot| {
+            try rws.append(gpa, .{
+                .game = @intCast(gi),
+                .slot = @intCast(slot),
+                .side = @intCast(slot / 5),
+                .role = @fromBackingInt(@as(u3, @intCast((slot + gi) % 5))),
+                .champion = champs[slot],
+                .y = @splat(std.math.nan(f32)),
+            });
+            try players.append(gpa, if (slot == 9) no_player else pool[slot]);
+            var rate: [3]f32 = undefined;
+            for (&rate) |*x| x.* = if (rnd.uintLessThan(u8, 5) == 0) std.math.nan(f32) else @floatFromInt(rnd.intRangeLessThan(u16, 1, 900));
+            try extras.append(gpa, .{ .kda = 1, .rate = rate });
+        }
+    }
+    try fillExperience(gpa, games, rws.items, players.items, extras.items);
+
+    const end = struct {
+        fn f(g: Game) i64 {
+            return g.start + @as(i64, g.duration_s) * 1000;
+        }
+    }.f;
+    const counts = struct {
+        fn f(g: Game, p: u32) bool {
+            return p != no_player and g.duration_s >= experience_min_s;
+        }
+    }.f;
+    var by_end: [n_games]u32 = undefined;
+    for (&by_end, 0..) |*e, k| e.* = @intCast(k);
+    std.mem.sort(u32, &by_end, @as([]const Game, games), struct {
+        fn lt(gs: []const Game, a: u32, b: u32) bool {
+            return end(gs[a]) < end(gs[b]);
+        }
+    }.lt);
+
+    // Skill: per game, replay from zero every game ended by its start, in end order
+    var overlapped: usize = 0;
+    var rel_seen: usize = 0;
+    var skill_seen: usize = 0;
+    var rating: [30]f32 = undefined;
+    var counted: [30]u32 = undefined;
+    for (games, 0..) |g, gi| {
+        @memset(&rating, 0);
+        @memset(&counted, 0);
+        for (by_end) |h| {
+            const eg = games[h];
+            if (end(eg) > g.start) break;
+            if (eg.duration_s < experience_min_s) continue;
+            const rows = rws.items[h * 10 ..][0..10];
+            const ps = players.items[h * 10 ..][0..10];
+            // fillSkill sums by side * 5 + role; summing in that order keeps f32 rounding
+            var diff: f32 = 0;
+            for (0..10) |s| for (rows, ps) |o, p| {
+                if (p != no_player and @as(usize, o.side) * 5 + @backingInt(o.role) == s)
+                    diff += if (o.side == 0) rating[p] else -rating[p];
+            };
+            const p_blue = 1 / (1 + @exp(-diff));
+            const y_blue: f32 = @floatFromInt(@intFromBool(eg.winner == 0));
+            for (rows, ps) |o, p| if (p != no_player) {
+                const step = skill_lr * skill_n0 / @as(f32, @floatFromInt(skill_n0 + counted[p]));
+                rating[p] += if (o.side == 0) step * (y_blue - p_blue) else -step * (y_blue - p_blue);
+                counted[p] += 1;
+            };
+        }
+        for (rws.items[gi * 10 ..][0..10], players.items[gi * 10 ..][0..10]) |r, p| {
+            const want = if (p == no_player) 0 else rating[p];
+            try std.testing.expectApproxEqAbs(want, r.skill_before, 1e-5);
+            skill_seen += @intFromBool(r.skill_before != 0);
+        }
+    }
+
+    // Relative rates: each earlier game's rate minus the mean over that champion-role's
+    // games ended strictly before it (so never its own game)
+    for (rws.items, players.items) |r, p| {
+        var sum: [3]f64 = @splat(0);
+        var n: [3]u32 = @splat(0);
+        if (p != no_player) for (rws.items, players.items, extras.items) |o, op, e| {
+            const g = games[o.game];
+            if (op != p or !counts(g, op)) continue;
+            if (end(g) > games[r.game].start) {
+                overlapped += @intFromBool(g.start < games[r.game].start);
+                continue;
+            }
+            for (e.rate, 0..) |x, k| if (!std.math.isNan(x)) {
+                var m_sum: f64 = 0;
+                var m_n: u32 = 0;
+                for (rws.items, players.items, extras.items) |m, mp, me| {
+                    const mg = games[m.game];
+                    if (!counts(mg, mp) or m.role != o.role or m.champion != o.champion) continue;
+                    if (end(mg) >= end(g) or std.math.isNan(me.rate[k])) continue;
+                    m_sum += me.rate[k];
+                    m_n += 1;
+                }
+                if (m_n > 0) {
+                    sum[k] += x - m_sum / @as(f64, @floatFromInt(m_n));
+                    n[k] += 1;
+                }
+            };
+        };
+        for ([_]f32{ r.gpm_rel_before, r.cspm_rel_before, r.dpm_rel_before }, sum, n) |got, s, k| {
+            if (k == 0) try std.testing.expect(std.math.isNan(got)) else try std.testing.expectApproxEqAbs(s / @as(f64, @floatFromInt(k)), got, 1e-2);
+        }
+        rel_seen += @intFromBool(!std.math.isNan(r.dpm_rel_before));
+    }
+    try std.testing.expect(overlapped > 0 and rel_seen > 0 and skill_seen > 0);
 }
