+test "relative rates use the champion-role's earlier mean; skill moves with outcomes" {
+    const gpa = std.testing.allocator;
+    // Three 20-minute games an hour apart: player 2 on top champion 1 (red) wins game 0;
+    // player 1 on the same champion and role (blue) wins game 1, then plays game 2
+    var games: [3]Game = undefined;
+    for (&games, [_]u1{ 1, 0, 0 }, 0..) |*g, w, i| g.* = .{ .match_id = "", .start = @intCast(i * 3_600_000), .patch = 0, .platform = 0, .is_test = false, .teams = undefined, .winner = w, .duration_s = 1200 };
+    var rws = [_]Row{
+        .{ .game = 0, .slot = 5, .side = 1, .role = .top, .champion = 1, .y = @splat(0) },
+        .{ .game = 1, .slot = 0, .side = 0, .role = .top, .champion = 1, .y = @splat(0) },
+        .{ .game = 2, .slot = 0, .side = 0, .role = .top, .champion = 1, .y = @splat(0) },
+    };
+    const players = [_]u32{ 2, 1, 1 };
+    const extras = [_]Extra{ .{ .kda = 1, .rate = .{ 600, 9, 900 } }, .{ .kda = 1, .rate = .{ 400, 7, 500 } }, .{ .kda = 1, .rate = .{ 500, 8, 700 } } };
+    try fillExperience(gpa, &games, &rws, &players, &extras);
+    try std.testing.expect(std.math.isNan(rws[1].gpm_rel_before));
+    try std.testing.expectEqual(@as(f32, -200), rws[2].gpm_rel_before);
+    try std.testing.expectEqual(@as(f32, -2), rws[2].cspm_rel_before);
+    try std.testing.expectEqual(@as(f32, -400), rws[2].dpm_rel_before);
+    // Equal ratings, so p = 0.5 and each winner moves up by skill_lr * 0.5
+    try std.testing.expectEqual(@as(f32, 0), rws[0].skill_before);
+    try std.testing.expectEqual(@as(f32, 0), rws[1].skill_before);
+    try std.testing.expectApproxEqAbs(@as(f32, skill_lr * 0.5), rws[2].skill_before, 1e-6);
+}
