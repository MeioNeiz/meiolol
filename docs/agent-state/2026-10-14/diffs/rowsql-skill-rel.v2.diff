+/// Skill step size: a player's rating moves by skill_lr * n0 / (n0 + n) * (won - p) after
+/// their n-th earlier game, so early games move it most and it settles (an Elo shrunk to 0)
+const skill_lr = 0.1;
+const skill_n0 = 10;
+
+/// Row.skill_before: per player an online rating; for each game ended by a row's start,
+/// p = sigmoid(sum of blue's ratings - red's) and each player moves towards the outcome,
+/// so a rating credits wins against strong lobbies more. Short games (< experience_min_s)
+/// and unknown players are skipped, as in fillExperience
+fn fillSkill(gpa: std.mem.Allocator, games: []const Game, rws: []Row, players: []const u32) !void {
+    var n_players: usize = 0;
+    for (players) |p| if (p != no_player) {
+        n_players = @max(n_players, p + 1);
+    };
+    const rating = try gpa.alloc(f32, n_players);
+    defer gpa.free(rating);
+    @memset(rating, 0);
+    const counted = try gpa.alloc(u32, n_players);
+    defer gpa.free(counted);
+    @memset(counted, 0);
+    const slots = try gpa.alloc([10]u32, games.len);
+    defer gpa.free(slots);
+    @memset(slots, @splat(no_player));
+    for (rws, players) |r, p| slots[r.game][@as(usize, r.side) * 5 + @backingInt(r.role)] = p;
+    const by_end = try gpa.alloc(u32, games.len);
+    defer gpa.free(by_end);
+    for (by_end, 0..) |*e, i| e.* = @intCast(i);
+    const by_start = try gpa.alloc(u32, rws.len);
+    defer gpa.free(by_start);
+    for (by_start, 0..) |*s, i| s.* = @intCast(i);
+    const Order = struct {
+        games: []const Game,
+        rws: []const Row,
+        fn end(o: @This(), g: u32) i64 {
+            return o.games[g].start + @as(i64, o.games[g].duration_s) * 1000;
         }
+        fn byEnd(o: @This(), a: u32, b: u32) bool {
+            return o.end(a) < o.end(b);
+        }
+        fn byStart(o: @This(), a: u32, b: u32) bool {
+            return o.games[o.rws[a].game].start < o.games[o.rws[b].game].start;
+        }
+    };
+    const order: Order = .{ .games = games, .rws = rws };
+    std.mem.sort(u32, by_end, order, Order.byEnd);
+    std.mem.sort(u32, by_start, order, Order.byStart);
+    var done: usize = 0;
+    for (by_start) |i| {
+        const start = games[rws[i].game].start;
+        while (done < by_end.len and order.end(by_end[done]) <= start) : (done += 1) {
+            const g = by_end[done];
+            if (games[g].duration_s < experience_min_s) continue;
+            var diff: f32 = 0;
+            for (slots[g], 0..) |p, s| if (p != no_player) {
+                diff += if (s < 5) rating[p] else -rating[p];
+            };
+            const p_blue = 1 / (1 + @exp(-diff));
+            const y_blue: f32 = @floatFromInt(@intFromBool(games[g].winner == 0));
+            for (slots[g], 0..) |p, s| if (p != no_player) {
+                const step = skill_lr * skill_n0 / @as(f32, @floatFromInt(skill_n0 + counted[p]));
+                rating[p] += if (s < 5) step * (y_blue - p_blue) else -step * (y_blue - p_blue);
+                counted[p] += 1;
+            };
+        }
+        if (players[i] != no_player) rws[i].skill_before = rating[players[i]];
     }
 }
 
